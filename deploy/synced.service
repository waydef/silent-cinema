# /etc/systemd/system/synced.service
# expects the code in /opt/synced (npm ci --omit=dev) and a user named synced
# that can read the film folder. settings go to /etc/synced.env (see .env.example).
[Unit]
Description=synced watch party
After=network-online.target
Wants=network-online.target

[Service]
User=synced
WorkingDirectory=/opt/synced
Environment=STATE_DIR=/var/lib/synced CACHE_DIR=/var/cache/synced
EnvironmentFile=-/etc/synced.env
ExecStart=/usr/bin/node server.js
# picks up a renewed certificate without dropping anyone
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2

StateDirectory=synced
CacheDirectory=synced
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=yes
# uncomment to serve https on port 443 directly (PORT=443 with TLS_CERT and TLS_KEY)
#AmbientCapabilities=CAP_NET_BIND_SERVICE
#CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
