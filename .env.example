# copy to .env (docker compose) or /etc/silent-cinema.env (systemd) and adjust

# public listener for viewers
PORT=8080
BIND=0.0.0.0
# https without a proxy: paths to the certificate chain and key (reloaded on SIGHUP)
#TLS_CERT=/etc/letsencrypt/live/cinema.example.com/fullchain.pem
#TLS_KEY=/etc/letsencrypt/live/cinema.example.com/privkey.pem
# names the public listener answers to, comma separated; empty accepts any
#PUBLIC_HOSTS=cinema.example.com
# the address shown to the host as "ask them to open ..."
#PUBLIC_URL=https://cinema.example.com
# set to 1 when a reverse proxy on this machine is the only way to the public port
#TRUST_PROXY=1

# host listener: the host page, keep it on loopback
HOST_PORT=8088
HOST_BIND=127.0.0.1
#HOST_HOSTS=

# films: library (folder list), dialog (desktop file chooser) or auto
PICKER=auto
MEDIA_DIR=~/Videos

# where the room and the stream cache live
#STATE_DIR=~/.local/state/silent-cinema
#CACHE_DIR=~/.cache/silent-cinema

#MAX_VIEWERS=40
#HOST_NAME=host
